{
  "name": "workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop shell for Workbook: discover repositories, import them as projects, and switch between their boards in one window.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "stage": "bash scripts/build-workbook.sh",
    "gen:ico": "node scripts/make-ico.js",
    "dist": "npm run stage && electron-builder --mac --arm64",
    "dist:mac": "npm run stage && electron-builder --mac",
    "dist:win": "npm run stage && electron-builder --win",
    "dist:linux": "npm run stage && electron-builder --linux",
    "check:styles": "node scripts/check-styles.js",
    "check:shell": "node scripts/check-shell.js",
    "check": "npm run check:styles && npm run check:shell"
  },
  "license": "MIT",
  "build": {
    "appId": "dev.workbench.app",
    "productName": "Workbench",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/WORKBOOK-LICENSE",
        "to": "WORKBOOK-LICENSE"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/dgoings/workbook/releases/download/desktop-latest"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "identity": null,
      "artifactName": "${productName}-${arch}.${ext}",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0",
        "NSHumanReadableCopyright": "Bundles the Workbook CLI (MIT). See WORKBOOK-LICENSE in Resources."
      },
      "extraResources": [
        {
          "from": "build/workbook",
          "to": "workbook"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "extraResources": [
        {
          "from": "build/workbook.exe",
          "to": "workbook.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workbench",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "afterPack": "scripts/after-pack.js",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "dgoings/workbook",
      "artifactName": "${productName}-${arch}.${ext}",
      "synopsis": "Desktop shell for Workbook",
      "description": "Discover Git repositories, import them as Workbook projects, and switch between their boards in one window.",
      "extraResources": [
        {
          "from": "build/workbook",
          "to": "workbook"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "Tyler Kilgore"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dgoings/workbook.git",
    "directory": "desktop"
  },
  "homepage": "https://github.com/dgoings/workbook"
}
