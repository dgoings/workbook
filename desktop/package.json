{
  "name": "workbench",
  "version": "0.3.2",
  "private": false,
  "description": "Desktop shell for Workbook: discover repositories, import them as projects, and switch between their boards in one window.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "stage": "bash scripts/build-workbook.sh",
    "gen:board-dark": "node scripts/generate-board-dark.js",
    "gen:ico": "node scripts/make-ico.js",
    "dist": "npm run stage && electron-builder --mac --arm64",
    "dist:mac": "npm run stage && electron-builder --mac",
    "dist:win": "npm run stage && electron-builder --win",
    "release": "npm run stage && electron-builder --publish always",
    "dist:linux": "npm run stage && electron-builder --linux",
    "check:workflows": "node scripts/check-workflows.js",
    "check:styles": "node scripts/check-styles.js"
  },
  "license": "MIT",
  "build": {
    "appId": "dev.workbench.app",
    "productName": "Workbench",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "build/WORKBOOK-LICENSE",
        "to": "WORKBOOK-LICENSE"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "tylerkilgore",
        "repo": "workbench"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "darkModeSupport": true,
      "identity": null,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0",
        "NSHumanReadableCopyright": "Bundles the Workbook CLI (MIT). See WORKBOOK-LICENSE in Resources."
      },
      "extraResources": [
        {
          "from": "build/workbook",
          "to": "workbook"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "extraResources": [
        {
          "from": "build/workbook.exe",
          "to": "workbook.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Workbench",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "afterPack": "scripts/after-pack.js",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "Tyler Kilgore",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "synopsis": "Desktop shell for Workbook",
      "description": "Discover Git repositories, import them as Workbook projects, and switch between their boards in one window.",
      "extraResources": [
        {
          "from": "build/workbook",
          "to": "workbook"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "author": {
    "name": "Tyler Kilgore"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tylerkilgore/workbench.git"
  },
  "homepage": "https://github.com/tylerkilgore/workbench",
  "workbook": {
    "repository": "https://github.com/tylerkilgore/workbook.git",
    "ref": "f01514d4fb0dae586a66d0b96cd56939f6024519",
    "upstream": "https://github.com/dgoings/workbook.git",
    "branches": [
      "feat/windows-support",
      "feat/relative-sync-indicator"
    ]
  }
}
